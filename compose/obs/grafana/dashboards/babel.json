{
 "uid": "babel-lag",
 "title": "Babel Lag pipeline",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "tags": [
  "babel-lag"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Records per stage run",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (stage, service) (increase(babel_stage_records_total[1h]))",
     "legendFormat": "{{stage}} {{service}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Stage duration (p50)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, stage, service) (rate(babel_stage_seconds_bucket[1h])))",
     "legendFormat": "{{stage}} {{service}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Bytes read per stage",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "decbytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (stage, service) (increase(babel_stage_bytes_bytes_total[1h]))",
     "legendFormat": "{{stage}} {{service}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Live: events per second / consumer lag",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "babel_live_events_per_second or babel_live_consumer_lag",
     "legendFormat": "{{stage}} {{service}}"
    }
   ]
  }
 ]
}
